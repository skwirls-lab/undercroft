rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist. Put your own Firebase UID here and leave it here — you are the only
    // admin. Admins can refresh the card database, change the app-wide settings in
    // Settings → Administration, and grant or revoke Patron by hand. Find your UID at
    // Firebase Console -> Authentication -> Users.
    //
    // Keep this list in step with NEXT_PUBLIC_ADMIN_UIDS in the app config. That variable only
    // decides who the admin UI lets in; this function is what actually stops a write.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'PASTE_YOUR_FIREBASE_UID_HERE'
      ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fields on a profile that only the server (billing webhook, usage metering) or an admin
    // may set. A player who could write these could promote themselves or reset their quota.
    function touchesProtected(keys) {
      return keys.hasAny([
        'plan', 'planSource', 'patronUntil', 'planNote', 'usage',
        'stripeCustomerId', 'stripeSubscriptionId', 'subscriptionStatus'
      ]);
    }

    // Global card data — readable by any signed-in player, writable only by an admin.
    //
    // Reads are restricted to authenticated users because this collection holds ~90k
    // documents and every read is billed; leaving it open to the world is a standing
    // billing-drain vector. Nothing in the app reads cards before sign-in (deck import and
    // the game store are both behind AuthGuard), so this costs no functionality.
    match /cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // App-wide configuration (config/app): the Archivist's master switch and model, the
    // monthly allowances, the notice banner. Every signed-in player reads it; an admin
    // writes it from the Settings panel.
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Monthly usage totals and the per-call log, written by the server with admin
    // credentials (which bypass these rules). Admins read them in the Settings panel;
    // nobody writes them from a browser.
    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /archivistLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Stripe's idempotency ledger: one document per webhook event, server-written.
    match /stripeEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User profiles. A player reads and writes their own, except the protected fields
    // above. An admin may read any profile (the email lookup in the Settings panel lists
    // the collection) and change exactly the plan fields — never the shelves or anything
    // else that belongs to the player.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && !touchesProtected(request.resource.data.keys());
      allow update: if (isOwner(userId)
          && !touchesProtected(request.resource.data.diff(resource.data).affectedKeys()))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['plan', 'planSource', 'patronUntil', 'planNote']));
      allow delete: if isOwner(userId);
    }

    // User's decks — users can read/write their own decks
    // Separate rule to allow listing empty collections
    match /users/{userId}/decks/{deckId} {
      allow read, write: if isOwner(userId);
    }

    // Anything not matched above is denied. Stated explicitly so a future collection is
    // closed by default rather than inheriting a permissive parent by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
