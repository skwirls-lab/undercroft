rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global card data - read-only for all authenticated users
    // TEMPORARY: Write access enabled for initial population
    // TODO: Change "allow write: if true" to "allow write: if false" after populating cards
    match /cards/{cardId} {
      allow read: if true; // Anyone can read cards (even unauthenticated)
      allow write: if true; // TEMPORARY - for initial card population
    }
    
    // User profiles - users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's decks - users can read/write their own decks
    // Separate rule to allow listing empty collections
    match /users/{userId}/decks/{deckId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
