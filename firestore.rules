rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global card data - read-only for all authenticated users
    // Write access only for admin operations (via API routes)
    match /cards/{cardId} {
      allow read: if true; // Anyone can read cards (even unauthenticated)
      allow write: if false; // Only server-side can write
    }
    
    // User profiles - users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's decks - users can read/write their own decks
    // Separate rule to allow listing empty collections
    match /users/{userId}/decks/{deckId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
