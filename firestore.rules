rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist. Add the Firebase UID of each person allowed to rewrite the shared
    // card database. Keep this in step with NEXT_PUBLIC_ADMIN_UIDS in the app config — that
    // variable only decides what the admin UI offers; this function is what enforces it.
    //
    //   function isAdmin() {
    //     return request.auth != null && request.auth.uid in [
    //       'PASTE_YOUR_FIREBASE_UID_HERE'
    //     ];
    //   }
    //
    // With the list empty, nobody can write to /cards. That is the correct steady state: the
    // collection is already populated, and repopulating it is a rare, deliberate act. To run
    // the admin populate page, add your UID above, deploy the rules, populate, then remove it.
    function isAdmin() {
      return false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Global card data — readable by any signed-in player, writable only by an admin.
    //
    // Reads are restricted to authenticated users because this collection holds ~90k
    // documents and every read is billed; leaving it open to the world is a standing
    // billing-drain vector. Nothing in the app reads cards before sign-in (deck import and
    // the game store are both behind AuthGuard), so this costs no functionality.
    match /cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User profiles — users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User's decks — users can read/write their own decks
    // Separate rule to allow listing empty collections
    match /users/{userId}/decks/{deckId} {
      allow read, write: if isOwner(userId);
    }

    // Anything not matched above is denied. Stated explicitly so a future collection is
    // closed by default rather than inheriting a permissive parent by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
