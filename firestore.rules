rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist. Put your own Firebase UID here and leave it here — you are the only
    // admin, and the admin pages (/admin/populate-cards, /admin/import-missing-cards) are how
    // the card database gets updated when a new set releases. Find your UID at
    // Firebase Console -> Authentication -> Users.
    //
    // Keep this list in step with NEXT_PUBLIC_ADMIN_UIDS in the app config. That variable only
    // decides who the admin UI lets in; this function is what actually stops a write.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'PASTE_YOUR_FIREBASE_UID_HERE'
      ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Global card data — readable by any signed-in player, writable only by an admin.
    //
    // Reads are restricted to authenticated users because this collection holds ~90k
    // documents and every read is billed; leaving it open to the world is a standing
    // billing-drain vector. Nothing in the app reads cards before sign-in (deck import and
    // the game store are both behind AuthGuard), so this costs no functionality.
    match /cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User profiles — users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User's decks — users can read/write their own decks
    // Separate rule to allow listing empty collections
    match /users/{userId}/decks/{deckId} {
      allow read, write: if isOwner(userId);
    }

    // Anything not matched above is denied. Stated explicitly so a future collection is
    // closed by default rather than inheriting a permissive parent by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
