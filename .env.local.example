# Firebase Configuration
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# AI Provider (optional)
# NEXT_PUBLIC_AI_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key

# Admin allowlist (optional)
# Comma-separated Firebase UIDs allowed to reach /admin/* and rewrite the shared card
# database. Set this to your own UID (Firebase Console -> Authentication -> Users) and leave
# it set, or the admin pages will refuse you. The same UIDs must also be added to the
# isAdmin() function in firestore.rules; this variable only controls the UI.
# NEXT_PUBLIC_ADMIN_UIDS=uid-one,uid-two

# The Archivist (server only — never NEXT_PUBLIC_)
# OPENROUTER_API_KEY=sk-or-...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # whole JSON, one line
# ARCHIVIST_STUB=1            # canned answers, no model call (previews and local testing)

# Billing (server only). See SECURITY_SETUP.md section 7.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...   # the $4.99/month Patron price
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_SITE_URL=https://your-domain   # where Stripe sends players back

# The launch switch for the paywall. Unset = everything unlocked for everyone.
# NEXT_PUBLIC_ENFORCE_ENTITLEMENTS=1
