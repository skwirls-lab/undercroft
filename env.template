# Copy this file to .env.local and fill in your values.

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin allowlist — comma-separated Firebase UIDs allowed to reach /admin/*, which is
# where the card database gets refreshed for a new set. Set this to your own UID and
# also add it to the isAdmin() function in firestore.rules, which is what enforces it.
NEXT_PUBLIC_ADMIN_UIDS=

# The Archivist (server only — never NEXT_PUBLIC_)
# OPENROUTER_API_KEY=sk-or-...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # whole JSON, one line
# ARCHIVIST_STUB=1            # canned answers, no model call (previews and local testing)

# Billing (server only). See SECURITY_SETUP.md section 7.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...   # the $4.99/month Patron price
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_SITE_URL=https://your-domain   # where Stripe sends players back

# The launch switch for the paywall. Unset = everything unlocked for everyone.
# NEXT_PUBLIC_ENFORCE_ENTITLEMENTS=1
